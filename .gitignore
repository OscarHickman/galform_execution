# Private notes (literature.md, ROADMAP.md, achievements.md) are excluded
# via .git/info/exclude, not here.

# --- Physics data, outputs and plots (never commit) ---
*.hdf5
*.h5
*.dat
*.csv
*.tsv
*.fits
*.npy
*.npz
*.pkl
*.parquet
data/
convergence_results*/
*_plots/
# root-level scratch images from notebooks
/*.png
/*.pdf

# --- HPC / SLURM logs ---
slurm-*.out
*.log
*.err
core.*
.last_job_id
*monitor_memory*
logs/

# --- Local scratch directories ---
scripts/
examples/ongoing/

# --- Compiled binaries ---
*.o
*.so
*.a
*.out
*.exe
*.mod
bin/

# --- Python bytecode ---
__pycache__/
*.py[cod]
*$py.class

# --- Packaging / build ---
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.manifest
*.spec

# --- Testing, coverage, tool caches ---
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.ipynb_checkpoints/

# --- Environments and secrets ---
.python-version
.env
.venv*
env/
venv/
ENV/
env.bak/
venv.bak/

# --- IDEs and OS files ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- AI agents (AGENTS.md is tracked) ---
.claude/
.mcp.json
CLAUDE.md
CLAUDE.local.md
GEMINI.md

# =====================================================================
# Added 2026-10-26 (cross-repo .gitignore audit): rules this file lacked
# =====================================================================

# ---- SLURM / HPC output ----
.nfs*

# ---- Bulk data, simulation products and trained models (live on /cosma5-8) ----
*.pt
*.pth
*.ckpt

# ---- Talk / presentation figure scripts (kept on disk, never tracked) ----
/talks/

# ---- Secrets ----
.env.*

# ---- Local agent / editor state ----
.cursor/
.gemini/
.serena/
.playwright-mcp/
.antigravity*/

# ---- Markdown is ignored by default ----
# Agent notes, plans, reviews, drafts and dated write-ups stay on disk but out
# of git. Real documentation is re-included by name; add a line here for a
# new doc (or `git add -f` it).
*.md
!README.md
!AGENTS.md
!CHANGELOG.md
!CONTRIBUTING.md
!LICENSE.md
